{
  "manifest_version": 2,
  "name": "BiliWebAndroidStream",
  "version": "0.2.4",
  "description": "Bridge Bilibili web playback requests to a local Android playback helper.",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://passport.bilibili.com/*",
    "https://grpc.biliapi.net/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.mountaintoys.cn/*",
    "*://*.akamaized.net/*",
    "*://*.szbdyd.com/*"
  ],
  "background": {
    "scripts": [
      "src/lib/md5.js",
      "src/lib/qrcode.js",
      "src/native-api.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "src/content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "src/page-bridge.js"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "biliwebandroidstream@example.invalid",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {}
}
